# 复制为 .env 后填入你自己的真实值（.env 已被 .gitignore 忽略，切勿提交到仓库）

# ---- 大模型（DashScope 通义千问，OpenAI 兼容模式）----
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxx

LLM_MODEL_NAME=qwen3.6-flash
LLM_REASONING_MODEL=qwen3.6-plus
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_MAIN_TEMPERATURE=0.3
LLM_REASONING_TEMPERATURE=0.2
SQL_TEMPERATURE=0.0
RAG_TEMPERATURE=0.3
MEETING_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_REASONING_MAX_TOKENS=4000
LLM_ENABLE_THINKING=true

# ---- 应用安全（务必改成随机串，不要用默认值）----
SECRET_KEY=please-change-me

# ---- 飞书自建应用 ----
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=

# ---- 数据库 ----
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxx
DB_NAME=feishu_assistant

# ---- 服务端口 ----
SERVER_PORT=8000

# ---- 联网搜索（可选）----
TAVILY_API_KEY=tvly-xxx
BING_SEARCH_API_KEY=xxx
