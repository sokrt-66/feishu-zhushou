# 复制为 .env 后填入真实配置，请勿把 .env 提交到仓库

# 大模型（阿里云百炼 DashScope，OpenAI 兼容接口）
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

LLM_MODEL_NAME=qwen3.6-flash
LLM_REASONING_MODEL=qwen3.6-plus
LLM_EMBEDDING_MODEL=text-embedding-v4

LLM_MAIN_TEMPERATURE=0.0
LLM_REASONING_TEMPERATURE=0.1
SQL_TEMPERATURE=0.1
RAG_TEMPERATURE=0.3
MEETING_TEMPERATURE=0.5
LLM_MAX_TOKENS=2000
LLM_REASONING_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false

# 服务端会话密钥
SECRET_KEY=please-generate-a-random-secret-key

# 飞书开放平台
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_VERIFICATION_TOKEN=your-verification-token
FEISHU_ENCRYPT_KEY=

# 数据库
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=company

# 服务端口
SERVER_PORT=5001

# 联网搜索
TAVILY_API_KEY=tvly-dev-your-tavily-key
BING_SEARCH_API_KEY=
